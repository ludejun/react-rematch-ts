{
  "name": "react-rematch-ts",
  "version": "1.0.0",
  "private": true,
  "description": "A production-ready React scaffold: React 19, Rematch, React Router 7, TypeScript and webpack 5, with mocking, request middleware and monitoring wired up.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludejun/react-rematch-ts.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "start": "ts-node ./webpack/dev.ts --bundleSize=false",
    "start:size": "ts-node ./webpack/dev.ts --bundleSize=true",
    "start:mock": "ts-node ./webpack/dev.ts --mock=true",
    "dev": "ts-node ./webpack/dev.ts",
    "build": "cross-env NODE_ENV=prod webpack --config ./webpack/prod.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,less,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,less,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@rematch/core": "^2.2.0",
    "core-js": "^3.39.0",
    "dayjs": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.1",
    "react-router-dom": "^7.1.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/plugin-proposal-decorators": "^8.0.0",
    "@babel/plugin-transform-runtime": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "less-loader": "^13.0.0",
    "lint-staged": "^17.5.1",
    "mini-css-extract-plugin": "^2.10.2",
    "mockjs": "^1.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^11.5.3",
    "prettier": "^3.6.2",
    "react-refresh": "^0.19.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,less,css}": [
      "prettier --write"
    ]
  }
}
